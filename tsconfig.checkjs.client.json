{
  "extends": "./tsconfig.checkjs.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "baseUrl": ".",
    "paths": {
      "/shared/*": [
        "shared/*"
      ]
    },
    "types": []
  },
  "include": [
    "client/**/*.js",
    "client/types/**/*.d.ts",
    "shared/**/*.js"
  ],
  "exclude": [
    "**/*.test.js",
    "client/vendor/**",
    "client/utils/BufferGeometryUtils.js",
    "server/**",
    "admin/**",
    "e2e/**",
    "scripts/**",
    "node_modules/**"
  ]
}
