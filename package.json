{
  "name": "mmorpg-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "check:tscheck:coverage": "node scripts/check-ts-check-coverage.js",
    "typecheck:server": "tsc -p tsconfig.checkjs.server.json",
    "typecheck:client": "tsc -p tsconfig.checkjs.client.json",
    "typecheck:admin": "tsc -p tsconfig.checkjs.admin.json",
    "typecheck:tools": "tsc -p tsconfig.checkjs.tools.json",
    "typecheck": "npm run typecheck:server && npm run typecheck:client && npm run typecheck:admin && npm run typecheck:tools",
    "test:unit": "vitest run",
    "test": "npm run check:tscheck:coverage && npm run typecheck && npm run test:unit",
    "test:e2e": "node e2e/playwright-e2e.js",
    "test:E2E": "npm run test:e2e",
    "test:e2e:tutorial": "node e2e/playwright-e2e-tutorial.js",
    "test:e2e:trade": "node e2e/playwright-e2e-trade.js",
    "test:e2e:duel": "node e2e/playwright-e2e-duel.js",
    "test:e2e:scenarios": "node e2e/run-e2e-scenarios.js",
    "test:e2e:admin": "E2E_PORT=3907 node e2e/playwright-admin-map-v2.js",
    "db:migrate:dev": "prisma migrate dev",
    "db:reset:test": "node scripts/db-reset.js test",
    "db:reset:e2e": "node scripts/db-reset.js e2e"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^7.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "playwright": "^1.50.1",
    "prisma": "^5.10.0",
    "typescript": "^5.9.3",
    "vitest": "^1.6.0"
  },
  "overrides": {
    "qs": "6.14.2"
  }
}
