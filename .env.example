# Development database
DATABASE_URL=postgresql://USER@localhost:5432/mmorpg_dev
ADMIN_PASSWORD=change-me

# Test databases
DATABASE_URL_TEST=postgresql://USER@localhost:5432/mmorpg_test
DATABASE_URL_E2E=postgresql://USER@localhost:5432/mmorpg_e2e

# Optional: persistence interval in ms
PERSIST_INTERVAL_MS=5000

# Optional: max HTTP JSON body size in bytes for admin endpoints
ADMIN_MAX_PAYLOAD_BYTES=262144

# Optional: admin web session settings
ADMIN_SESSION_COOKIE_NAME=mmorpg_admin_session
ADMIN_SESSION_IDLE_TIMEOUT_MS=1800000
ADMIN_SESSION_COOKIE_SAMESITE=strict
# ADMIN_SESSION_COOKIE_SECURE=false

# Player respawn delay in ms (default: 60000 = 1 min)
RESPAWN_MS=60000

# Corpse expiry in ms (default: 600000 = 10 min)
CORPSE_EXPIRY_MS=600000
